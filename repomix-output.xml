        <Route element={<RequireRole roles={['student']} />}>
          <Route path="/history" element={<HistoryPage />} />
        </Route>

        <Route element={<RequireRole roles={['teacher']} />}>
          <Route path="/admin" element={<AdminPage />} />                {/* Slide 2A */}
