// Learning history: stored only for students who log in with Gmail.
import { db } from '../config/db.js';
import { HttpError } from '../utils/httpError.js';

// POST /api/history  { subjectId, resourceId?, action: "view_subject" | "open_paper" | "ask_ai" }
export const addHistory = (req, res) => {
  const { subjectId, resourceId, action } = req.body || {};
  if (!subjectId || !action) throw new HttpError(400, 'subjectId and action are required');
  if (!db.prepare('SELECT 1 FROM subjects WHERE id = ?').get(subjectId)) throw new HttpError(404, 'Subject not found');
  db.prepare('INSERT INTO history (user_email, subject_id, resource_id, action) VALUES (?,?,?,?)')
    .run(req.user.email, subjectId, resourceId || null, action);
  res.status(201).end();
};

// GET /api/history -> the 20 most recently studied subjects
export const listHistory = (req, res) => {
  res.json(db.prepare(`
    SELECT s.id, s.name, s.branch, s.year, s.semester, s.credits, MAX(h.created_at) AS last_seen
    FROM history h JOIN subjects s ON s.id = h.subject_id
    WHERE h.user_email = ? GROUP BY s.id ORDER BY last_seen DESC LIMIT 20
  `).all(req.user.email));
};
</file>

<file path="server/src/middleware/auth.js">
// Authentication middleware. One signed token (JWT) format for everyone:
//   teacher -> { role: 'teacher' }
//   student -> { role: 'student', email }
//   guest   -> sends no token at all
import jwt from 'jsonwebtoken';
import { env } from '../config/env.js';
import { HttpError } from '../utils/httpError.js';

const readToken = (req) => {
  const header = req.headers.authorization || '';
  if (!header.startsWith('Bearer ')) return null;
  try {
    return jwt.verify(header.slice(7), env.jwtSecret);
  } catch {
    return null;
  }
};

export const signToken = (payload) => jwt.sign(payload, env.jwtSecret, { expiresIn: '12h' });

export const requireTeacher = (req, _res, next) => {
  const t = readToken(req);
  if (t?.role !== 'teacher') return next(new HttpError(401, 'Teacher login required'));
  next();
};

export const requireStudent = (req, _res, next) => {
  const t = readToken(req);
  if (t?.role !== 'student') return next(new HttpError(401, 'Please login with your Gmail to do this'));
  req.user = { email: t.email };
  next();
};

// Sets req.user for logged-in students; guests continue with req.user = null.
export const optionalStudent = (req, _res, next) => {
  const t = readToken(req);
  req.user = t?.role === 'student' ? { email: t.email } : null;
  next();
};
</file>

