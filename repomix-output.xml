export default function App() {
  return (
    <Routes>
      <Route element={<Layout />}>
        <Route path="/" element={<LoginPage />} />                       {/* Slide -1 */}
        <Route path="/student" element={<StudentLoginPage />} />         {/* Slide 2B */}

