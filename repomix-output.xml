// Teacher: add a new unit to an existing subject.
import { useState } from 'react';
import { api } from '../api';

const ROMAN = ['I', 'II', 'III', 'IV', 'V', 'VI', 'VII', 'VIII'];

export default function AddUnit({ subjectId, existing, onChanged }) {
  const [open, setOpen] = useState(false);
  const [name, setName] = useState('');
  const [text, setText] = useState('');
  const [error, setError] = useState('');
  const [busy, setBusy] = useState(false);

  const suggestion = ROMAN.find((r) => !existing.includes(r)) || '';
  const unitName = name.trim() || suggestion;

  const submit = async (e) => {
    e.preventDefault();
    setBusy(true); setError('');
    try {
      onChanged(await api.saveUnit(subjectId, unitName, text));
      setOpen(false); setName(''); setText('');
    } catch (err) {
      setError(err.message);
    } finally {
      setBusy(false);
    }
  };

  if (!open) return <button className="btn" onClick={() => setOpen(true)}>+ Add a unit</button>;
  return (
    <form className="card form" onSubmit={submit}>
      <h3>Add a unit</h3>
      <label>Unit name
        <input value={name} onChange={(e) => setName(e.target.value)} placeholder={suggestion} maxLength={12} />
      </label>
      {existing.includes(unitName) && <p className="muted">Unit {unitName} already exists. Saving will replace its text.</p>}
      <label>Syllabus
        <textarea rows="5" value={text} onChange={(e) => setText(e.target.value)} required />
      </label>
      {error && <p className="error" role="alert">{error}</p>}
      <div className="row-end">
        <button type="button" className="btn btn-sm" onClick={() => setOpen(false)}>Cancel</button>
        <button className="btn btn-sm btn-primary" disabled={busy || !text.trim()}>{busy ? 'Saving...' : 'Add unit'}</button>
      </div>
    </form>
  );
}
</file>

<file path="client/src/components/Backdrop.jsx">
// Animated background: a drifting network of nodes with "signals" travelling along the links
// (a nod to the project name). Also powers the cursor spotlight on cards.
// Pure canvas, no libraries. Pauses when the tab is hidden and is skipped for reduced-motion users.
import { useEffect, useRef } from 'react';

const LINK_DIST = 150;
const RGB = '110, 231, 183'; // accent colour

export default function Backdrop() {
  const canvasRef = useRef(null);

  useEffect(() => {
    const canvas = canvasRef.current;
    const ctx = canvas.getContext('2d');
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const mouse = { x: -9999, y: -9999 };
    let w = 0, h = 0, nodes = [], pulses = [], raf = 0;

    const resize = () => {
      const dpr = Math.min(window.devicePixelRatio || 1, 2);
      w = window.innerWidth;
      h = window.innerHeight;
      canvas.width = w * dpr;
      canvas.height = h * dpr;
      canvas.style.width = `${w}px`;
      canvas.style.height = `${h}px`;
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      const count = Math.min(95, Math.floor((w * h) / 15000));
      nodes = Array.from({ length: count }, () => ({
        x: Math.random() * w, y: Math.random() * h,
        vx: (Math.random() - 0.5) * 0.35, vy: (Math.random() - 0.5) * 0.35,
        r: Math.random() * 1.3 + 0.7,
      }));
    };

    const draw = () => {
      ctx.clearRect(0, 0, w, h);

      for (const n of nodes) {
        n.x += n.vx; n.y += n.vy;
        if (n.x < 0 || n.x > w) n.vx *= -1;
        if (n.y < 0 || n.y > h) n.vy *= -1;
        const dx = n.x - mouse.x, dy = n.y - mouse.y, d = Math.hypot(dx, dy);
        if (d < 130 && d > 0) { n.x += (dx / d) * 0.6; n.y += (dy / d) * 0.6; } // gently pushed by the cursor
      }

      // links
      for (let i = 0; i < nodes.length; i++) {
        for (let j = i + 1; j < nodes.length; j++) {
          const d = Math.hypot(nodes[i].x - nodes[j].x, nodes[i].y - nodes[j].y);
          if (d < LINK_DIST) {
            ctx.strokeStyle = `rgba(${RGB}, ${(1 - d / LINK_DIST) * 0.22})`;
            ctx.lineWidth = 1;
            ctx.beginPath(); ctx.moveTo(nodes[i].x, nodes[i].y); ctx.lineTo(nodes[j].x, nodes[j].y); ctx.stroke();
          }
        }
      }
      // links to the cursor
      for (const n of nodes) {
        const d = Math.hypot(n.x - mouse.x, n.y - mouse.y);
        if (d < 190) {
          ctx.strokeStyle = `rgba(${RGB}, ${(1 - d / 190) * 0.5})`;
          ctx.beginPath(); ctx.moveTo(n.x, n.y); ctx.lineTo(mouse.x, mouse.y); ctx.stroke();
        }
      }
      // nodes
      ctx.fillStyle = `rgba(${RGB}, 0.7)`;
      for (const n of nodes) { ctx.beginPath(); ctx.arc(n.x, n.y, n.r, 0, 6.283); ctx.fill(); }

      // signals travelling between connected nodes
      if (pulses.length < 7 && Math.random() < 0.05 && nodes.length) {
        const a = nodes[Math.floor(Math.random() * nodes.length)];
        const b = nodes.find((n) => n !== a && Math.hypot(n.x - a.x, n.y - a.y) < LINK_DIST);
        if (b) pulses.push({ a, b, t: 0 });
      }
      pulses = pulses.filter((p) => p.t < 1);
      for (const p of pulses) {
        p.t += 0.018;
        const x = p.a.x + (p.b.x - p.a.x) * p.t, y = p.a.y + (p.b.y - p.a.y) * p.t;
        const glow = ctx.createRadialGradient(x, y, 0, x, y, 12);
        glow.addColorStop(0, `rgba(${RGB}, 0.95)`); glow.addColorStop(1, `rgba(${RGB}, 0)`);
        ctx.fillStyle = glow;
        ctx.beginPath(); ctx.arc(x, y, 12, 0, 6.283); ctx.fill();
      }
    };

    const loop = () => { draw(); raf = requestAnimationFrame(loop); };
    const onMove = (e) => {
      mouse.x = e.clientX; mouse.y = e.clientY;
      const card = e.target.closest?.('.card');           // cursor spotlight on cards
      if (card) {
        const r = card.getBoundingClientRect();
        card.style.setProperty('--mx', `${e.clientX - r.left}px`);
        card.style.setProperty('--my', `${e.clientY - r.top}px`);
      }
    };
    const onVisibility = () => {
      cancelAnimationFrame(raf);
      if (!document.hidden && !reduceMotion) raf = requestAnimationFrame(loop);
    };

    resize();
    if (reduceMotion) draw(); else raf = requestAnimationFrame(loop);
    window.addEventListener('resize', resize);
    window.addEventListener('mousemove', onMove);
    window.addEventListener('mouseleave', () => { mouse.x = mouse.y = -9999; });
    document.addEventListener('visibilitychange', onVisibility);
    return () => {
      cancelAnimationFrame(raf);
      window.removeEventListener('resize', resize);
      window.removeEventListener('mousemove', onMove);
      document.removeEventListener('visibilitychange', onVisibility);
    };
  }, []);

  return (
    <>
      <canvas ref={canvasRef} className="backdrop" aria-hidden="true" />
      <div className="backdrop-fade" aria-hidden="true" />
    </>
  );
}
