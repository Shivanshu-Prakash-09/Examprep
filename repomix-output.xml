        <div className="empty">No subjects found. Try the search options on the previous page.</div>
      )}
      <div className="subject-grid">
        {subjects?.map((s, i) => <SubjectCard key={s.id} subject={s} index={i} />)}
      </div>
    </div>
  );
}
